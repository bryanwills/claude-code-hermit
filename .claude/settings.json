{
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(node */skills/hermit-scribe/file-issue.js*)",
      "Bash(bun */scripts/routines.ts tz-shift*)",
      "Bash(node */scripts/resolve-outbound-channel.js *)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/d0m/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/d0m/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "claude-code-hermit@claude-code-hermit": true,
    "skill-creator@claude-plugins-official": true
  }
}
